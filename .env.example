# ============================================================
#  IT Ticketing System — Environment Configuration
#  Copy this file to .env and fill in the values.
#  .env is excluded from git — never commit secrets.
# ============================================================

# ── Required ─────────────────────────────────────────────────

# JWT signing secret. Generate a strong random key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left blank, the server auto-generates a strong key on first start and
# persists it to backend/secret.key (gitignored) so tokens survive restarts.
# Set it explicitly for multi-node deployments so every node shares one key.
SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────

# Restrict CORS to your server's origin (recommended in production).
# Prevents browser-based requests from unauthorized origins.
# Default: * (allow all origins — suitable for LAN-only deployment)
# Example (single origin):
#   CORS_ORIGINS=http://192.168.1.50:8000
# Example (multiple origins, comma-separated):
#   CORS_ORIGINS=http://192.168.1.50:8000,https://helpdesk.yourdomain.com
# CORS_ORIGINS=http://192.168.1.50:8000

# Server bind host.
# Default: 0.0.0.0 (listens on all network interfaces)
# HOST=0.0.0.0

# Server port.
# Default: 8000
# PORT=8000

# JWT lifetime in hours. Default: 8
# ACCESS_TOKEN_EXPIRE_HOURS=8

# ── Reverse proxy ────────────────────────────────────────────
# Set ONLY if the server sits behind a reverse proxy (nginx / Caddy / IIS /
# load balancer). Comma-separated list of that proxy's IP address(es).
#
# Why it matters: X-Forwarded-For is supplied by the caller and can be forged.
# Rate limiting therefore keys on the real socket peer unless the request came
# from an IP listed here. Get this wrong in either direction and you have a
# problem:
#   * Behind a proxy but UNSET  -> every client looks like the proxy, so they
#                                  all share one rate-limit bucket and staff
#                                  start getting spurious 429s on login.
#   * No proxy but SET          -> callers can forge their apparent IP and walk
#                                  past the login brute-force limit.
# Default: unset (correct for a directly-exposed LAN server).
# TRUSTED_PROXY_IPS=10.0.0.1

# ── Rate limiting (protects public endpoints from spam / brute force) ──
# Requests allowed per window, per client IP. Set RATE_LIMIT_ENABLED=false to
# disable entirely (not recommended in production).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_TICKET_CREATE=20
# RATE_LIMIT_ATTACHMENT=30
# RATE_LIMIT_LOGIN=10

# Max attachment upload size in bytes. Default: 10 MB
# MAX_UPLOAD_BYTES=10485760

# ── Data retention ───────────────────────────────────────────
# Auto-delete tickets older than N days at 02:00. Default 0 = keep everything
# (recommended for corporate deployments that need full history for auditing).
# TICKET_RETENTION_DAYS=0
