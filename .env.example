# ============================================================
#  IT Ticketing System — Environment Configuration
#  Copy this file to .env and fill in the values.
#  .env is excluded from git — never commit secrets.
# ============================================================

# ── Required ─────────────────────────────────────────────────

# JWT signing secret. Generate a strong random key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left blank, the server auto-generates a strong key on first start and
# persists it to backend/secret.key (gitignored) so tokens survive restarts.
# Set it explicitly for multi-node deployments so every node shares one key.
SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────

# Restrict CORS to your dashboard's origin (recommended in production).
# Prevents browser-based requests from unauthorized origins.
#
# Since v1.2 the dashboards call whichever origin served them, so if staff reach
# them at http://SERVER:8000/admin and /tech, every request is same-origin and
# tightening this breaks nothing. The server prints a notice at startup while
# the wildcard is in use.
#
# Default: * (allow all origins — suitable for LAN-only deployment)
# Example (single origin):
#   CORS_ORIGINS=http://192.168.1.50:8000
# Example (multiple origins, comma-separated):
#   CORS_ORIGINS=http://192.168.1.50:8000,https://helpdesk.yourdomain.com
# CORS_ORIGINS=http://192.168.1.50:8000

# Server bind host.
# Default: 0.0.0.0 (listens on all network interfaces)
# HOST=0.0.0.0

# Server port.
# Default: 8000
# PORT=8000

# JWT lifetime in hours. Default: 8
# ACCESS_TOKEN_EXPIRE_HOURS=8

# ── Rate limiting (protects public endpoints from spam / brute force) ──
# Requests allowed per window, per client IP. Set RATE_LIMIT_ENABLED=false to
# disable entirely (not recommended in production).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_TICKET_CREATE=20
# RATE_LIMIT_ATTACHMENT=30
# RATE_LIMIT_LOGIN=10
# Polling by the desktop tray client (it polls every 30s, so 60 is generous).
# RATE_LIMIT_CLIENT_POLL=60

# Max attachment upload size in bytes. Default: 10 MB
# MAX_UPLOAD_BYTES=10485760

# ── Data retention ───────────────────────────────────────────
# Auto-delete tickets older than N days at 02:00. Default 0 = keep everything
# (recommended for corporate deployments that need full history for auditing).
# TICKET_RETENTION_DAYS=0

# ── Self-update (OFF by default) ─────────────────────────────
# "Apply Update" in the admin dashboard makes the server pull code from a git
# remote and restart into it. That is remote code execution by design: anyone
# who obtains a super_admin session on a server with this enabled controls the
# host. It is therefore disabled unless you deliberately turn it on, and
# updating by hand on the server is the recommended default.
#
# When enabled, the server additionally refuses to update unless the checkout's
# 'origin' remote points at exactly this repository on github.com, and unless
# the working tree is clean. The pull is fast-forward only.
# SELF_UPDATE_ENABLED=false

# Repository the server may update from, as "owner/repo". Required when
# SELF_UPDATE_ENABLED is true; also enables the read-only update check.
# GITHUB_REPO=your-org/ticketing-system

# ── Database ─────────────────────────────────────────────────
# Defaults to sqlite:///./helpdesk.db relative to the backend directory.
# Keep the database on local disk — SQLite file locking is unreliable on
# network shares and synced folders (OneDrive, Dropbox), which surfaces as
# intermittent "database is locked" errors.
# DATABASE_URL=sqlite:////var/lib/helpdesk/helpdesk.db

# ── TLS ──────────────────────────────────────────────────────
# The server speaks plain HTTP. For anything beyond a trusted LAN, terminate
# TLS at a reverse proxy (nginx, Caddy, IIS) in front of it and keep the
# backend bound to localhost:
#   HOST=127.0.0.1
# The proxy must forward WebSocket upgrade headers, or live chat silently falls
# back to slower polling. It must also send X-Forwarded-For, or per-IP rate
# limits apply to the proxy as a whole rather than to each user.
# See docs/TROUBLESHOOTING.md for a working nginx configuration.
